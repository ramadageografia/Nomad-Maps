        "            <tr><td>📍 <strong>Clique</strong></td><td>Detalhes da região</td></tr>\n",
        "            <tr><td>🗺️ <strong>Camadas</strong></td><td>Mude o estilo do mapa</td></tr>\n",
        "        </table>\n",
        "    </div>\n",
        "\n",
        "    <div style=\"margin-bottom: 12px;\">\n",
        "        <h4 style=\"margin: 0 0 8px 0; color: #2c3e50; font-size: 13px; border-bottom: 1px solid #eee; padding-bottom: 5px;\">🎨 LEGENDA DE CORES</h4>\n",
        "        <div style=\"font-size: 11px;\">\n",
        "            <div style=\"display: flex; align-items: center; margin-bottom: 5px; padding: 4px; border-radius: 3px; background: linear-gradient(90deg, rgba(255,0,0,0.1), white);\">\n",
        "                <div style=\"width: 15px; height: 15px; background: #FF0000; margin-right: 8px; border-radius: 3px; border: 1px solid #ccc;\"></div>\n",
        "                <div><strong>Sul:</strong> +109.2% (alta crítica)</div>\n",
