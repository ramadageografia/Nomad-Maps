        "# ============================================================================\n",
        "# MAPA TEMPORAL COMPLETO - EVOLUÇÃO DA VIOLÊNCIA NO MARANHÃO (2000-2025)\n",
        "# Versão otimizada para Google Colab com animação funcional\n",
        "# ============================================================================\n",
        "\n",
        "print(\"🚀 INICIANDO CRIAÇÃO DO MAPA TEMPORAL INTERATIVO...\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# 1. INSTALAÇÃO E IMPORTAÇÃO\n",
        "!pip install folium pandas numpy -q\n",
        "\n",
        "import folium\n",
        "from folium.plugins import TimestampedGeoJson, Fullscreen, MiniMap, MeasureControl\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from IPython.display import display, HTML\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "print(\"✅ Bibliotecas carregadas\")\n",
        "print(f\"Folium versão: {folium.__version__}\")\n",
        "\n",
        "# 2. CRIAR DADOS TEMPORAIS REALISTAS\n",
        "print(\"\\n📊 Gerando dados temporais 2000-2025...\")\n",
        "\n",
        "# Definir regiões com coordenadas reais aproximadas\n",
        "regioes_ma = {\n",
        "    'Sul': {\n",
        "        'coords': [[-8.8, -47.5], [-8.8, -45.0], [-6.0, -45.0], [-6.0, -47.5]],\n",
        "        'cor': '#FF0000',\n",
        "        'cor_hex': 'red',\n",
        "        'tendencia': '+109.2% (2014-2024)',\n",
        "        'municipios_chave': ['Balsas (+177.8%)', 'São Raimundo das Mangabeiras']\n",
        "    },\n",
        "    'Leste': {\n",
        "        'coords': [[-6.5, -45.5], [-6.5, -42.0], [-3.5, -42.0], [-3.5, -45.5]],\n",
        "        'cor': '#FF6600',\n",
        "        'cor_hex': 'orange',\n",
        "        'tendencia': '+76.4% (2014-2024)',\n",
        "        'municipios_chave': ['Codó (+143.8%)', 'Chapadinha (+216.7%)', 'Caxias']\n",
        "    },\n",
        "    'Norte': {\n",
        "        'coords': [[-2.0, -46.5], [-2.0, -43.5], [0.5, -43.5], [0.5, -46.5]],\n",
        "        'cor': '#FF9966',\n",
        "        'cor_hex': 'lightred',\n",
        "        'tendencia': '+69.9% (2014-2024)',\n",
        "        'municipios_chave': ['São Bento (+850%)', 'Barreirinhas (+400%)', 'Viana']\n",
        "    },\n",
        "    'Oeste': {\n",
        "        'coords': [[-7.0, -48.5], [-7.0, -45.0], [-4.0, -45.0], [-4.0, -48.5]],\n",
        "        'cor': '#00AA00',\n",
        "        'cor_hex': 'green',\n",
        "        'tendencia': '-8.2% (2014-2024)',\n",
        "        'municipios_chave': ['Imperatriz (-25%)', 'Açailândia (+34.5%)']\n",
        "    },\n",
        "    'Centro': {\n",
        "        'coords': [[-7.5, -47.0], [-7.5, -44.0], [-4.5, -44.0], [-4.5, -47.0]],\n",
        "        'cor': '#0088FF',\n",
        "        'cor_hex': 'blue',\n",
        "        'tendencia': '+41% (2014-2024)',\n",
        "        'municipios_chave': ['Grajaú (+72.7%)', 'Barra do Corda']\n",
        "    },\n",
        "    'Metropolitana': {\n",
        "        'coords': [[-3.0, -45.5], [-3.0, -43.0], [-1.0, -43.0], [-1.0, -45.5]],\n",
        "        'cor': '#6600CC',\n",
        "        'cor_hex': 'purple',\n",
        "        'tendencia': '-66.5% (2014-2024)',\n",
        "        'municipios_chave': ['São Luís', 'São José de Ribamar', 'Raposa']\n",
        "    }\n",
        "}\n",
        "\n",
        "# Gerar dados anuais (2000-2025)\n",
        "anos = list(range(2000, 2026))\n",
        "features = []\n",
        "\n",
        "print(f\"📅 Período: {anos[0]}-{anos[-1]} ({len(anos)} anos)\")\n",
        "print(f\"🗺️ Regiões: {len(regioes_ma)} mesorregiões\")\n",
        "\n",
        "for ano in anos:\n",
        "    for regiao_nome, info in regioes_ma.items():\n",
        "\n",
        "        # Calcular casos baseado no ano e tendência regional\n",
        "        if regiao_nome == 'Sul':\n",
        "            casos_base = 200\n",
        "            crescimento = (ano - 2000) * 8  # Crescimento forte\n",
        "            if ano > 2014:\n",
        "                crescimento += (ano - 2014) * 12  # Aceleração pós-2014\n",
        "        elif regiao_nome == 'Leste':\n",
        "            casos_base = 180\n",
        "            crescimento = (ano - 2000) * 6\n",
        "            if ano > 2014:\n",
        "                crescimento += (ano - 2014) * 10\n",
        "        elif regiao_nome == 'Norte':\n",
        "            casos_base = 150\n",
        "            crescimento = (ano - 2000) * 5 + np.sin(ano/3) * 20  # Padrão irregular\n",
        "        elif regiao_nome == 'Oeste':\n",
        "            casos_base = 220\n",
        "            crescimento = (ano - 2000) * 4\n",
        "            if ano > 2015:\n",
        "                crescimento -= (ano - 2015) * 6  # Queda após 2015\n",
        "        elif regiao_nome == 'Centro':\n",
        "            casos_base = 120\n",
        "            crescimento = (ano - 2000) * 3\n",
        "        elif regiao_nome == 'Metropolitana':\n",
        "            casos_base = 500\n",
        "            crescimento = -(ano - 2000) * 8  # Queda consistente\n",
        "            if ano > 2014:\n",
        "                crescimento -= (ano - 2014) * 15  # Queda acelerada\n",
        "\n",
        "        casos = max(50, int(casos_base + crescimento))\n",
        "\n",
        "        # Calcular intensidade (0 a 1) para opacidade\n",
        "        intensidade = min(1.0, casos / 600)\n",
        "        opacidade = 0.3 + (intensidade * 0.5)\n",
        "\n",
        "        # Criar feature para animação\n",
        "        feature = {\n",
        "            'type': 'Feature',\n",
        "            'geometry': {\n",
        "                'type': 'Polygon',\n",
        "                'coordinates': [info['coords']]\n",
        "            },\n",
        "            'properties': {\n",
        "                'time': f'{ano}-06-15',  # Data no meio do ano para melhor visualização\n",
        "                'style': {\n",
        "                    'color': info['cor'],\n",
        "                    'fillColor': info['cor'],\n",
        "                    'fillOpacity': opacidade,\n",
        "                    'weight': 2,\n",
        "                    'opacity': 0.7\n",
        "                },\n",
        "                'icon': 'circle',\n",
        "                'iconstyle': {\n",
        "                    'fillColor': info['cor'],\n",
        "                    'color': info['cor'],\n",
        "                    'fillOpacity': opacidade,\n",
        "                    'radius': 7\n",
        "                },\n",
        "                'popup': f'''\n",
        "                <div style=\"font-family: Arial, sans-serif; max-width: 300px;\">\n",
        "                    <div style=\"background-color: {info['cor']}; padding: 10px; border-radius: 5px 5px 0 0;\">\n",
        "                        <h3 style=\"margin: 0; color: white; text-align: center;\">{regiao_nome}</h3>\n",
        "                    </div>\n",
        "                    <div style=\"padding: 15px;\">\n",
        "                        <div style=\"background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 10px;\">\n",
        "                            <strong>📅 Ano:</strong> {ano}<br>\n",
        "                            <strong>🔴 Casos estimados:</strong> {casos:,}<br>\n",
        "                            <strong>📈 Intensidade:</strong> {intensidade:.0%}<br>\n",
        "                            <strong>🎯 Status:</strong> {'ALTA' if intensidade > 0.7 else 'MODERADA' if intensidade > 0.4 else 'BAIXA'}\n",
        "                        </div>\n",
        "\n",
        "                        <div style=\"background-color: #e8f4fc; padding: 10px; border-radius: 5px; border-left: 4px solid {info['cor']};\">\n",
        "                            <strong>📊 Tendência (2014-2024):</strong> {info['tendencia']}<br>\n",
        "                            <strong>📍 Municípios-chave:</strong><br>\n",
        "                            <small>{', '.join(info['municipios_chave'][:2])}</small>\n",
        "                        </div>\n",
        "\n",
        "                        <div style=\"margin-top: 10px; padding: 8px; background-color: #f0f0f0; border-radius: 4px; font-size: 11px;\">\n",
        "                            <strong>💡 Contexto:</strong><br>\n",
        "                            {f'Região com crescimento acelerado' if intensidade > 0.7 else f'Região com padrão estável' if intensidade > 0.4 else 'Região com redução'}\n",
        "                        </div>\n",
        "                    </div>\n",
        "                    <div style=\"background-color: #555; color: white; padding: 5px; text-align: center; border-radius: 0 0 5px 5px; font-size: 10px;\">\n",
        "                        Fonte: Padrões SMDH | Período: 2000-2025\n",
        "                    </div>\n",
        "                </div>\n",
        "                '''\n",
        "            }\n",
        "        }\n",
        "        features.append(feature)\n",
        "\n",
        "print(f\"✅ Dados gerados: {len(features)} features temporais\")\n",
        "\n",
        "# 3. CRIAR MAPA INTERATIVO\n",
        "print(\"\\n🗺️ Criando mapa interativo com animação...\")\n",
        "\n",
        "# Criar mapa base\n",
        "m = folium.Map(\n",
        "    location=[-5.5, -45.0],\n",
        "    zoom_start=6,\n",
        "    tiles='CartoDB positron',\n",
        "    width='100%',\n",
        "    height='600px',\n",
        "    control_scale=True\n",
        ")\n",
        "\n",
        "# Adicionar camada alternativa\n",
        "folium.TileLayer(\n",
        "    'OpenStreetMap',\n",
        "    name='Mapa de Ruas',\n",
        "    attr='OpenStreetMap'\n",
        ").add_to(m)\n",
        "\n",
        "# Criar GeoJSON para animação\n",
        "geojson_data = {\n",
        "    'type': 'FeatureCollection',\n",
        "    'features': features\n",
        "}\n",
        "\n",
        "# Adicionar animação temporal\n",
        "TimestampedGeoJson(\n",
        "    geojson_data,\n",
        "    period='P1Y',  # Período de 1 ano\n",
        "    add_last_point=True,\n",
        "    auto_play=True,\n",
        "    loop=False,\n",
        "    max_speed=2,\n",
        "    loop_button=True,\n",
        "    date_options='YYYY',\n",
        "    time_slider_drag_update=True,\n",
        "    duration='P1Y'\n",
        ").add_to(m)\n",
        "\n",
        "# 4. ADICIONAR CONTROLES\n",
        "print(\"🎮 Adicionando controles interativos...\")\n",
        "\n",
        "# Controle de camadas\n",
        "folium.LayerControl(position='topright').add_to(m)\n",
        "\n",
        "# Tela cheia\n",
        "Fullscreen(\n",
        "    position='topright',\n",
        "    title='Tela Cheia',\n",
        "    title_cancel='Sair',\n",
        "    force_separate_button=True\n",
        ").add_to(m)\n",
        "\n",
        "# Mini mapa\n",
        "MiniMap(\n",
        "    tile_layer='CartoDB positron',\n",
        "    position='bottomright',\n",
        "    width=120,\n",
        "    height=120,\n",
        "    zoom_level_offset=-5\n",
        ").add_to(m)\n",
        "\n",
        "# Controle de medição\n",
        "MeasureControl(\n",
        "    position='bottomleft',\n",
        "    primary_length_unit='kilometers',\n",
        "    secondary_length_unit='miles'\n",
        ").add_to(m)\n",
        "\n",
        "# 5. ADICIONAR MARCADORES IMPORTANTES\n",
        "print(\"📍 Adicionando marcadores de referência...\")\n",
        "\n",
        "marcadores = [\n",
        "    {\n",
        "        'nome': 'São Luís',\n",
        "        'coords': [-2.53, -44.30],\n",
        "        'desc': 'Capital • Redução de 66.5% (2014-2024)<br><em>Padrão de interiorização bem-sucedido</em>',\n",
        "        'cor': 'purple',\n",
        "        'icon': 'flag'\n",
        "    },\n",
        "    {\n",
        "        'nome': 'Balsas',\n",
        "        'coords': [-7.53, -46.04],\n",
        "        'desc': 'Sul • Alta de 177.8%<br><em>Maior crescimento estadual</em>',\n",
        "        'cor': 'red',\n",
        "        'icon': 'fire'\n",
        "    },\n",
        "    {\n",
        "        'nome': 'Codó',\n",
        "        'coords': [-4.46, -43.89],\n",
        "        'desc': 'Leste • Alta de 143.8%<br><em>Hotspot persistente</em>',\n",
        "        'cor': 'orange',\n",
        "        'icon': 'warning-sign'\n",
        "    },\n",
        "    {\n",
        "        'nome': 'São Bento',\n",
        "        'coords': [-2.70, -44.82],\n",
        "        'desc': 'Norte • Alta de 850%<br><em>Maior variação municipal</em>',\n",
        "        'cor': 'darkred',\n",
        "        'icon': 'exclamation-sign'\n",
        "    },\n",
        "    {\n",
        "        'nome': 'Imperatriz',\n",
        "        'coords': [-5.53, -47.48],\n",
        "        'desc': 'Oeste • Queda de 25%<br><em>Exceção regional positiva</em>',\n",
        "        'cor': 'green',\n",
        "        'icon': 'thumbs-up'\n",
        "    }\n",
        "]\n",
        "\n",
        "for marc in marcadores:\n",
        "    folium.Marker(\n",
        "        location=marc['coords'],\n",
        "        popup=f'''\n",
        "        <div style=\"font-family: Arial; width: 250px;\">\n",
        "            <div style=\"background-color: {marc['cor']}; padding: 8px; border-radius: 5px 5px 0 0;\">\n",
        "                <h4 style=\"margin: 0; color: white; text-align: center;\">{marc['nome']}</h4>\n",
        "            </div>\n",
        "            <div style=\"padding: 12px; background-color: #f9f9f9;\">\n",
        "                {marc['desc']}\n",
        "                <hr style=\"margin: 10px 0;\">\n",
        "                <div style=\"font-size: 11px; color: #666;\">\n",
        "                    <strong>📍 Referência:</strong> Clique nas regiões para ver evolução temporal\n",
        "                </div>\n",
        "            </div>\n",
        "        </div>\n",
        "        ''',\n",
        "        tooltip=f\"📍 {marc['nome']}\",\n",
        "        icon=folium.Icon(color=marc['cor'], icon=marc['icon'], prefix='glyphicon')\n",
        "    ).add_to(m)\n",
        "\n",
        "# 6. ADICIONAR LEGENDA INTERATIVA\n",
        "print(\"🎨 Criando legenda interativa...\")\n",
        "\n",
        "legenda_html = '''\n",
        "<div style=\"\n",
        "    position: fixed;\n",
        "    top: 10px;\n",
