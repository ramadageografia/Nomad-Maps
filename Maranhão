        "    padding: 12px;\n",
        "    font-family: Arial, sans-serif;\n",
        "    font-size: 12px;\n",
        "    z-index: 9999;\n",
        "    box-shadow: 0 3px 10px rgba(0,0,0,0.2);\n",
        "    max-height: 85vh;\n",
        "    overflow-y: auto;\n",
        "\">\n",
        "    <div style=\"text-align: center; margin-bottom: 10px;\">\n",
        "        <div style=\"background: linear-gradient(90deg, #2E86AB, #A23B72); color: white; padding: 8px; border-radius: 5px;\">\n",
        "            <h3 style=\"margin: 0; font-size: 14px;\">🗺️ ANIMAÇÃO TEMPORAL</h3>\n",
        "            <p style=\"margin: 3px 0 0 0; font-size: 11px;\">Maranhão 2000-2025</p>\n",
        "        </div>\n",
        "    </div>\n",
        "\n",
        "    <div style=\"margin-bottom: 12px;\">\n",
        "        <h4 style=\"margin: 0 0 8px 0; color: #2c3e50; font-size: 13px; border-bottom: 1px solid #eee; padding-bottom: 5px;\">🎮 CONTROLES</h4>\n",
        "        <table style=\"width: 100%; font-size: 11px; border-collapse: collapse;\">\n",
        "            <tr><td>▶️ <strong>Play/Pause</strong></td><td>Inicia/pausa animação</td></tr>\n",
